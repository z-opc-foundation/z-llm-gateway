<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-llm-gateway</artifactId>
        <version>${revision}</version>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-llm-gateway-admin</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>

    <name>z-llm-admin (Control Plane)</name>
    <description>管理面 — provider / model / api-key / 限流 / 计量 / 健康 等管理 REST 接口与最小化 UI 资源</description>

    <!-- 本模块原先自带 maven.compiler.source/target=8 与 project.build.sourceEncoding=UTF-8 三格，
         与父链（z-boot-parent 的 <properties>，面值与行号见根 pom 注释）逐字节相同 ⇒ 随迁移删掉，
         由 parent 下发。自家 sibling 的 <version>${revision}</version> 保持不动（根 pom 的
         <dependencyManagement> 钉的是同一格 ${revision}）。
         本模块是 compile 线上唯一带 spring-boot-starter-web 的一支 ⇒ 地板那条 spring-boot-starter-logging
         `*:*` 排除在这里吃掉了 logback-classic / logback-core / log4j-to-slf4j / jul-to-slf4j
         （判定与"刻意不补回"的理由写在 z-llm-starter/pom.xml 的对应注释里，同一把尺）。 -->

    <url>https://github.com/z-opc-foundation/z-llm</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-llm.git</connection>
        <developerConnection>scm:ssh:git@github.com/z-opc-foundation/z-llm.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-llm</url>
        <tag>HEAD</tag>
    </scm>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-llm-gateway-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-llm-gateway-core</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- admin 走完整 web + thymeleaf (最小 UI) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- 控制面注册开关 + 凭证掩码的回归测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ApplicationContextRunner 的上下文断言载体 -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>