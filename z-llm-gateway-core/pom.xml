<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-llm-gateway</artifactId>
        <version>${revision}</version>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-llm-gateway-core</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>

    <name>z-llm-gateway-core (Gateway)</name>
    <description>HTTP 网关核心 — 双协议适配 (OpenAI/Anthropic) + AK 保管 + Provider 注册 + 计量/限流</description>

    <!-- 本模块原先自带 maven.compiler.source/target=8 与 project.build.sourceEncoding=UTF-8 三格，
         与父链（z-boot-parent 的 <properties>，面值与行号见根 pom 注释）逐字节相同 ⇒ 随迁移删掉，
         由 parent 下发。下面自家 sibling 的 <version>${revision}</version> 保持不动：根 pom 的
         <dependencyManagement> 已把 5 个 reactor 坐标钉成同一个 ${revision}，两处同源不会分叉。 -->

    <url>https://github.com/z-opc-foundation/z-llm</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-llm.git</connection>
        <developerConnection>scm:ssh:git@github.com/z-opc-foundation/z-llm.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-llm</url>
        <tag>HEAD</tag>
    </scm>

    <dependencies>
        <!-- 本仓 DTO -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-llm-gateway-api</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- kernel: 调用 provider -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-agent-kernel-llm</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-agent-kernel-message</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-agent-kernel-types</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-agent-kernel-tool</artifactId>
        </dependency>

        <!-- Spring Web (HTTP 控制器 + SSE) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>

        <!-- Spring Boot (仅取 @ConfigurationProperties 注解, 不引入完整 starter) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>

        <!-- Jakarta Servlet API (Spring Boot 2.7 用 javax, 但 spring-web 5 已部分 jakarta, 锁定 javax) -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
        </dependency>

        <!-- JSON 编解码: 网关自身一律走 z-util 的 JsonUtil / JsonCursor。
             jackson-databind 只为 Spring MVC 的 @RequestBody 绑定保留 (EmbeddingsRequest
             是 MVC 出口的 DTO, 它的 @JsonProperty 仍然活着), 不再被本仓代码直接引用。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-parser-json</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>

        <!-- 日志门面 (实际 impl 由引入方决定, 本仓只引 API) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- 单元测试 -->
        <!-- HTTP 协议层测试 (MockMvc): 双协议 controller 此前 0 覆盖 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.jayway.jsonpath</groupId>
            <artifactId>json-path</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>