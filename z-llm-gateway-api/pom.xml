<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-llm-gateway</artifactId>
        <version>${revision}</version>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-llm-gateway-api</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>

    <name>z-llm-gateway-api (DTO)</name>
    <description>公共 DTO 与异常类型 (UnifiedRequest/Response, ChatMessage, Choice, UsageInfo, ApiKey, LlmCredential)</description>

    <!-- 本模块原先自带 maven.compiler.source/target=8 与 project.build.sourceEncoding=UTF-8 三格，
         与父链（z-boot-parent 的 <properties>，面值与行号见根 pom 注释）逐字节相同 ⇒ 随迁移删掉，
         由 parent 下发。本模块唯一的依赖 jackson-annotations 一直就是零 <version>（吃受管项），
         迁移后那份受管项来自地板的 jackson-bom。 -->

    <url>https://github.com/z-opc-foundation/z-llm-gateway</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-llm-gateway.git</connection>
        <developerConnection>scm:ssh:git@github.com/z-opc-foundation/z-llm-gateway.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-llm-gateway</url>
        <tag>HEAD</tag>
    </scm>

    <dependencies>
        <!-- 只有注解, 无 Spring / 无 databind / 无 kernel 依赖, 业务仍可单独引用.
             annotations 用来把响应 DTO 钉成 OpenAI 线格式 (finish_reason / prompt_tokens ...),
             此前 DTO 直接按 Java 字段名出 JSON, 任何官方 SDK 都解析不了. -->
        <!-- DTO 的对外线格式注解 (@JsonSerialize / @JsonDeserialize) 在这个包里.
             EmbeddingsRequest/EmbeddingsResponse 仍是 Spring MVC 的请求体/响应体,
             它们那份 jackson-annotations 保留 (注解仍被 MVC 转换器读)。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-parser-json</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
    </dependencies>
</project>