<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-llm-gateway</artifactId>
        <version>${revision}</version>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-llm-gateway-starter</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>

    <name>z-llm-starter (Auto-Configuration)</name>
    <description>Spring Boot Starter — auto-configuration + properties binding + 注册 ChatGatewayService / controllers</description>

    <!-- 本模块原先自带 maven.compiler.source/target=8 与 project.build.sourceEncoding=UTF-8 三格，
         与父链（z-boot-parent 的 <properties>，面值与行号见根 pom 注释）逐字节相同 ⇒ 随迁移删掉，
         由 parent 下发。自家 sibling 的 <version>${revision}</version> 保持不动（根 pom 的
         <dependencyManagement> 钉的是同一格 ${revision}）。

         ⚠ 本模块是"地板那条 `*:*` 排除"落在实处的地方（现读 z-boot-dependencies/pom.xml:502-509：
         spring-boot-starter-logging 被挂 <exclusions><exclusion>*:*</exclusion></exclusions>）：
         迁移后 spring-boot-starter-test → spring-boot-starter-logging 这个壳还在（2.7.18），
         但它的三个孩子 ch.qos.logback:logback-classic / logback-core、
         org.apache.logging.log4j:log4j-to-slf4j、org.slf4j:jul-to-slf4j 从 test 图上消失
         （两遍 dependency:tree 实测，见 commit message）。
         刻意**不补回**：本仓 74 支 java（main 50 + test 24）里 ch.qos.logback / org.apache.logging /
         java.util.logging 的引用是 0 处（15 支走 org.slf4j 门面），仓内没有任何 logback*.xml /
         log4j2*.xml / logging*.properties（现 grep 与 find 均 0 命中），唯一与日志有关的直接依赖是
         z-llm-core 那支 slf4j-api（门面，迁移后仍在 1.7.36）；
         z-llm 是给宿主应用用的库，log impl 由宿主带，这是组织口径而不是本仓的损失。
         冒烟测试 ZLlmAutoConfigurationSmokeTest 只断言 bean 存在，不读日志：迁移前后
         本模块 test 数与全仓 test 数逐格相同（0 F / 0 E）。 -->

    <url>https://github.com/z-opc-foundation/z-llm</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-llm.git</connection>
        <developerConnection>scm:ssh:git@github.com/z-opc-foundation/z-llm.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-llm</url>
        <tag>HEAD</tag>
    </scm>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-llm-gateway-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-llm-gateway-core</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- Spring Boot Auto-Configuration -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- starter 自身注册用 spring-web -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- 单元测试 -->

        <!-- Spring Boot Test (冒烟测试) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>